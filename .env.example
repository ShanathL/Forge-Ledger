# ForgeLedger Environment Configuration
# Reference: Lanka Shanath, "Integrated Manufacturing Workspace for Small Manufacturers"

# Server Port (Default: 4000)
PORT=4000

# MySQL / MariaDB Connection (e.g. XAMPP MySQL, local MySQL 8.x)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=forge_ledger

# Authentication Secret (At least 32 characters)
JWT_SECRET=forgeledger_production_jwt_secret_srm_cse_2026_super_secure_key_32chars

# Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5173
